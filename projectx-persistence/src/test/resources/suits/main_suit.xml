<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Main_Test_Suit_Configuration_Services">
	<listeners>
		<listener class-name="com.github.projectx.testinfra.GroupingAnnotationTransformer"/>
	</listeners>
	<!-- groups moved to suite level -->
	<groups>
		<define name="all_test">
			<include name="fetch"/>
			<include name="insert"/>
			<include name="update"/>
			<include name="delete"/>
		</define>
		<define name="fetch_test">
			<include name="fetch"/>
		</define>
		<define name="insert_test">
			<include name="insert"/>
		</define>
		<define name="update_test">
			<include name="update"/>
		</define>
		<define name="delete_test">
			<include name="delete"/>
		</define>
		<run>
			<include name="insert"/>
		</run>
	</groups>
	<test name="Main_Test_Cases">
		<packages>
			<package name="com.github.projectx.integrationTests"/>
		</packages>
	</test>
</suite>
